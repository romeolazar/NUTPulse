# Local web authentication. Change every value before production use.
WEB_USERNAME=admin
WEB_PASSWORD=change-me
AUTH_SECRET=replace-with-a-long-random-value
COOKIE_SECURE=false

# NUT server connection.
NUT_HOST=nut-server
NUT_SERVER_NAME=NUT Server
NUT_PORT=3493
NUT_POLL_INTERVAL=10

# Application defaults.
TZ=Europe/Bucharest
ENERGY_PRICE=1.20
RAW_SAMPLE_RETENTION_DAYS=90

# SMTP is optional until email reports are enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
