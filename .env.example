# Leave these blank to create the first administrator in the browser.
# Set all three only when credentials must be managed by the deployment environment.
WEB_USERNAME=admin
WEB_PASSWORD=
AUTH_SECRET=
COOKIE_SECURE=false

# Leave NUT_HOST blank for the first-run experience, then configure it in Settings.
NUT_HOST=
NUT_SERVER_NAME=NUT Server
NUT_PORT=3493
NUT_POLL_INTERVAL=10

# Application defaults.
TZ=Europe/Bucharest
ENERGY_PRICE=1.20
RAW_SAMPLE_RETENTION_DAYS=90

# SMTP is optional until email reports are enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
